# Local development only.
# Copy this file to api/.env and fill in real values for local Docker dev.
# In production (Coolify), these variables are set in the Coolify UI's
# Environment Variables panel for each team's app — there is no .env file
# on the production server.

SECRET_KEY=<change-this-to-a-random-secret>
DB_USER=root
DB_HOST=db
DB_PORT=3306
DB_NAME=Zeus
MYSQL_ROOT_PASSWORD=<change-this-to-a-strong-password>

# NewsData.io — EU energy news (https://newsdata.io/documentation#first-request)
NEWSDATA_API_KEY=<key>

# ENTSO-E Transparency Platform — electricity prices, load, generation
# Get a key from https://transparency.entsoe.eu/ (My Account Settings → API access)
ENTSOE_API_KEY=<key>

# GIE AGSI — gas storage data for ML notebooks and journalist pages
AGSI_API_KEY=<key>
